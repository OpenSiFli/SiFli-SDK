LR_IROM1 {{ hex32(defines['__ROM_BASE']) }} {{ hex32(defines['__ROM_SIZE']) }}  {    ; load region size_region
  ER_IROM1 {{ hex32(defines['__ROM_BASE']) }} {{ hex32(defines['__ROM_SIZE']) }}  {  ; load address = execution address
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
   *(FSymTab)
   *.o (.rodata.*)
  }
  ER_IROM1_EX {{ hex32(defines['__ROM_EX_BASE']) }} {{ hex32(defines['__ROM_EX_SIZE']) }}  {  ; load address = execution address
   *.o (.l1_non_ret_text_*)
   *.o (.l1_non_ret_rodata_*)
  }

{% if defines.get('BSP_USING_PSRAM') %}
  RW_PSRAM1 {{ hex32(defines['__PSRAM_BASE']) }} {
{% if defines.get('PKG_USING_FFMPEG') %}
    mpeg*.o (.bss.*)
    h264*.o (.bss.*)
{% endif %}
  }
  RW_PSRAM_RET +0 UNINIT{  ; ZI data, retained
    *.o (.l2_ret_data_*)
    *.o (.l2_ret_bss_*)
    *.o (.l2_cache_ret_data_*)
    *.o (.l2_cache_ret_bss_*)
  }
  RW_PSRAM_NON_RET +0  UNINIT{  ; ZI data, not retained and reused by SRAM retention
    *.o (.l2_non_ret_data_*)
    *.o (.l2_non_ret_bss_*)
    *.o (.bss.l2_non_ret_bss_*)
    *.o (.l2_cache_non_ret_data_*)
    *.o (.l2_cache_non_ret_bss_*)
  }
  ScatterAssert((ImageLength(RW_PSRAM1)+ ImageLength(RW_PSRAM_RET) + ImageLength(RW_PSRAM_NON_RET))<{{ hex32(defines['__PSRAM_SIZE']) }})
{% endif %}

  RW_IRAM_RET {{ hex32(defines['__RAM_BASE']) }} {{ hex32(defines['__RAM_SIZE']) }} {
;    .ANY2 (+RW +ZI)
   *.o (.l1_ret_text_*)
   *.o (.l1_ret_rodata_*)
   *.o (.bss.retm_bss_*)
   *.o (.retm_data_*)

{% if defines.get('LTO_SUPPORT') %}
   *.o (.text.nor*)
   *.o (.text.HAL_FLASH*)
   *.o (.text.HAL_Init)
   *.o (.text.HAL_Delay*)
   *.o (.text.HAL_MspInit)
   *.o (.text.HAL_Delay)
   *.o (.text.BSP_Flash*)
   *.o (.text.sifli_light_handler)
   *.o (.text.sifli_deep_handler)
   *.o (.text.sifli_standby_handler)
   *.o (.text.SystemInitFromStandby)
   *.o (.text.SystemPowerOnModeGet)
   *.o (.text.BSP_GPIO_Set)
   *.o (.text.HAL_GetTick)
   *.o (.rodata.flash_cmd_table_list)
   *.o (.text.rt_memset)
   *.o (.text.HAL_PreInit)
   *.o (.text.BSP_IO_Init)
   *.o (.text.rt_hw_flash_init)
   rt_memclr*.o (.text)
   memset*.o    (.text)
   context_rvds.o (+RO)
{% else %}
   drv_spi_flash.o (+RO)
   flash.o (+RO)
   flash_table.o (.text.*)
   flash_table.o (.rodata.*)
   bf0_hal_hpaon.o (+RO)
   bf0_hal_mpi.o (+RO)
   bf0_hal_mpi_ex.o (+RO)
   bf0_hal_mpi_psram.o (+RO)
   drv_psram.o (+RO)
   context_rvds.o (+RO)
   drv_common.o (.text.HAL_GetTick)

   bf0_hal_rcc.o   (+RO)
   bf0_pm.o        (.text.sifli_light_handler)
   bf0_pm.o        (.text.sifli_deep_handler)
   bf0_pm.o        (.text.sifli_standby_handler)
   bf0_pm.o        (.text.SystemInitFromStandby)
   bf0_pm.o        (.text.SystemPowerOnModeGet)
   bf0_pm.o        (.text.BSP_GPIO_Set)
   bsp_init.o         (+RO)
   bsp_lcd_tp.o       (+RO)
   bsp_pinmux.o       (+RO)
   bsp_power.o        (+RO)
   bf0_hal_gpio.o     (+RO)
   bf0_hal.o          (.text.HAL_Init)
   *.o                (.text.HAL_Delay_us)
   *.o                (.text.HAL_Delay_us_)
   *.o                (.text.HAL_Delay_us2_)
   *.o                (.text.HAL_MspInit)
   *.o                (.text.HAL_Delay)
   bf0_hal_pinmux.o   (+RO)
   bf0_pin_const.o    (+RO)
   *.o                (.text.rt_memset)
   rt_memclr*.o (.text)
   memset*.o    (.text)

{% if defines.get('BSP_QSPI2_DUAL_MODE') %}
   bf0_hal_dma.o (+RO)
   *.o (.text.HAL_GetTick)
   *.o (.text.HAL_AssertFailed)
   *.o (.text.HAL_NVIC_DisableIRQ)
   bf0_hal_cortex.o (+RO)
{% endif %}

{% endif %}

  }

  RW_IRAM0 +0 UNINIT {  ; ZI data, not retained
{% if defines.get('BSP_USING_PM') %}
    *.o (non_ret) ; non-retention section
    *.o (STACK)   ; ISR stack
{% endif %}
    *.o (.l1_non_ret_data_*)
    *.o (.l1_non_ret_bss_*)
{% if not defines.get('BSP_USING_PSRAM') %}
    *.o (.l2_non_ret_data_*)
    *.o (.l2_non_ret_bss_*)
    *.o (.l2_cache_non_ret_data_*)
    *.o (.l2_cache_non_ret_bss_*)
    *.o (.nand_cache)
{% endif %}
}
  RW_IRAM1 +0  {  ; RW data  ,  retained
    ;*.o (Jlink_RTT, +First)
    *.o (.l1_ret_data_*)
    *.o (.l1_ret_bss_*)
   .ANY (+RW +ZI)
  }
  ScatterAssert(ImageLength(RW_IRAM_RET)+ImageLength(RW_IRAM0)+ImageLength(RW_IRAM1)<{{ hex32(defines['__RAM_SIZE']) }})
}

