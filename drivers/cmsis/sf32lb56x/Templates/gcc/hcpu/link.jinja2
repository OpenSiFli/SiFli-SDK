{% for r in defines.get('INT_RES_PARTS', []) %}
  .{{ r.name }} :
  {
{% for selector in r.selectors_gnu %}
    {{ selector }}
{% endfor %}
  } > {{ r.name_upper }}
{% endfor %}
{% endif %}
