import os
from building import *

objs = []
cwd = GetCurrentDir()

# The LC3 audio codec (Bluetooth LE Audio). Skipped on the simulator, whose
# toolchain has no <stdalign.h> -- which src/common.h includes.
if not GetDepend('ZBT') and not GetDepend('BSP_USING_PC_SIMULATOR'):
    items = os.listdir(cwd)

    for item in items:
        sconscript = os.path.join(cwd, item, 'SConscript')
        if os.path.isfile(sconscript):
            objs = objs + SConscript(os.path.join(item, 'SConscript'))

Return('objs')
