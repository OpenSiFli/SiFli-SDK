from building import *
Import('rtconfig')

src   = []
cwd   = GetCurrentDir()

src += ['adler32.c', 
        'compress.c', 
        'crc32.c', 
        'deflate.c', 
        'gzclose.c', 
        'gzlib.c', 
        'gzread.c', 
        'gzwrite.c', 
        'infback.c', 
        'inffast.c', 
        'inflate.c', 
        'inftrees.c', 
        'trees.c', 
        'uncompr.c', 
        'zutil.c',
        ]
path  = [cwd]

CPPDEFINES = []

# add minizip
if GetDepend('PKG_USING_MINIZIP'):
    CPPDEFINES += ['USE_FILE32API']
    src += ['contrib/minizip/zip.c',
            'contrib/minizip/unzip.c', 
           'contrib/minizip/ioapi.c', 
           'contrib/minizip/rt_unzip.c', 
            ]
    path = path + ['contrib/minizip']

# add src and include to group.
group = DefineGroup('zlib', src, depend = ['PKG_USING_ZLIB'], CPPPATH = path, CPPDEFINES = CPPDEFINES)

Return('group')
