menuconfig PKG_USING_LIBEPUB
    bool "Enable libepub"
    default n
    select PKG_USING_LIBXML2 if PKG_USING_LIBEPUB
    select PKG_USING_LIBZIP if PKG_USING_LIBEPUB
    select PKG_USING_ZLIB if PKG_USING_LIBEPUB
    select PKG_USING_MBEDTLS if PKG_USING_LIBEPUB && !BSP_USING_PC_SIMULATOR
    select PKG_USING_MBEDTLS_USE_ALL_CERTS if PKG_USING_LIBEPUB && !BSP_USING_PC_SIMULATOR
    select PKG_USING_MBEDTLS_USER_CERTS if PKG_USING_LIBEPUB && !BSP_USING_PC_SIMULATOR

