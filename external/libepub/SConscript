from building import *
Import('rtconfig')

cwd   = GetCurrentDir()
src   = [
        './src/epub.c',
        ]
path = [cwd + '/inc/']
CPPDEFINES = []

# add src and include to group.
group = DefineGroup('libepub', src, depend = ['PKG_USING_LIBEPUB'], CPPPATH = path, CPPDEFINES = CPPDEFINES)

Return('group')
