# Per-part-number defaults (MPI enable, MPI mode, QSPI memory size, PSRAM
# pkg type MPI/pinmap mode) live in one file per part number:
#   soc/sf32lb57x/Kconfig.sf32lb57<part>
#
# They must be sourced BEFORE the symbols declared in this file are defined, and
# before customer/boards/Kconfig_drv: configdefault inserts its defaults at the
# position where it was parsed, and kconfiglib picks the first default whose
# condition holds - sourcing them later would be silently overridden by the
# unconditional fallback defaults at the end of each symbol below.
source "$SIFLI_SDK/soc/sf32lb57x/Kconfig.*"

# Note: MPI MODE value is consistent with BSP_QSPIx_MODE
# If part number is unknown, fallback to mpi_mode defined by BSP_QSPIx_MODE
config BSP_PSRAM1_PKG_TYPE0_MPI_MODE
    int 
    depends on BSP_USING_PSRAM1
    default 0

config BSP_PSRAM1_PKG_TYPE0_PINMAP_MODE
    int 
    depends on BSP_USING_PSRAM1
    default 2

config BSP_PSRAM1_PKG_TYPE1_MPI_MODE
    int 
    depends on BSP_USING_PSRAM1
    default 0

config BSP_PSRAM1_PKG_TYPE1_PINMAP_MODE
    int 
    depends on BSP_USING_PSRAM1
    default 2

# Not used yet
config BSP_PSRAM1_PKG_TYPE2_MPI_MODE
    int 
    depends on BSP_USING_PSRAM1
    default 0

config BSP_PSRAM1_PKG_TYPE2_PINMAP_MODE
    int 
    depends on BSP_USING_PSRAM1
    default 2

# Not used yet
config BSP_PSRAM1_PKG_TYPE3_MPI_MODE
    int 
    depends on BSP_USING_PSRAM1
    default 0

config BSP_PSRAM1_PKG_TYPE3_PINMAP_MODE
    int 
    depends on BSP_USING_PSRAM1
    default 2

config BSP_PSRAM2_PKG_TYPE0_MPI_MODE
    int 
    depends on BSP_USING_PSRAM2
    default 0

config BSP_PSRAM2_PKG_TYPE0_PINMAP_MODE
    int 
    depends on BSP_USING_PSRAM2
    default 2

# Not used yet
config BSP_PSRAM2_PKG_TYPE1_MPI_MODE
    int 
    depends on BSP_USING_PSRAM2
    default 0

config BSP_PSRAM2_PKG_TYPE1_PINMAP_MODE
    int 
    depends on BSP_USING_PSRAM2
    default 2

# Not used yet
config BSP_PSRAM2_PKG_TYPE2_MPI_MODE
    int 
    depends on BSP_USING_PSRAM2
    default 0

config BSP_PSRAM2_PKG_TYPE2_PINMAP_MODE
    int 
    depends on BSP_USING_PSRAM2
    default 2

# Not used yet
config BSP_PSRAM2_PKG_TYPE3_MPI_MODE
    int 
    depends on BSP_USING_PSRAM2
    default 0

config BSP_PSRAM2_PKG_TYPE3_PINMAP_MODE
    int 
    depends on BSP_USING_PSRAM2
    default 2    