from building import *

cwd = GetCurrentDir()

src = Glob('./*.c')

path =  [cwd, 
         os.path.join(cwd, '../include')]

group = DefineGroup('Drivers', src, depend = ['BSP_USING_BOARD_FPGA_57X_EMMC'], CPPPATH = path)

if GetDepend('BSP_USING_BOARD_FPGA_57X_EMMC'):
    group = group + SConscript(os.path.join(cwd, '../fpga-57x_base/SConscript.base'), variant_dir="base", duplicate=0)

Return('group')
