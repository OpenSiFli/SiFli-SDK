from building import *
import os
import rtconfig

objs_ezip = []

objs_ezip += Glob('*.png')
objs_ezip += Glob('*.gif')

if 16 == GetConfigValue('LV_COLOR_DEPTH'):
    img_flags = '-rgb565'
else:
    img_flags = '-rgb888'

local_ccflags = ''
if rtconfig.PLATFORM == 'cl':
    img_flags += ' -cfile 1'
    local_ccflags = ' /FI"{}" '.format(os.path.join(GetCurrentDir(), 'pc_asset.h'))
else:
    img_flags += ' -section ROM3_IMG -cfile 2 -dpt 1'

src = Env.ImgResource(objs_ezip, img_flags)
group = DefineGroup('multlist_asset', src, depend=['PKG_USING_LITTLEVGL2RTT'],
                    LOCAL_CCFLAGS=local_ccflags)

Return('group')
