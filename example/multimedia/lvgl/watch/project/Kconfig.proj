#APP specific configuration.
config CUSTOM_MEM_MAP
    bool 
	select custom_mem_map
	default y if !SOC_SIMULATOR

config SOLUTION_ALLOC_MEM
    bool
    default y

config FREETYPE_TINY_FONT_FULL
    bool
    default y

# The app cache options (rotation / freetype / message / tiny ttf / image cache)
# are shared by all examples now, see middleware/lvgl/Kconfig_mem.
#
# Enable the dedicated pools this project needs here, together with the size:
#
#   CONFIG_FREETYPE_CACHE_IN_PSRAM=y
#   CONFIG_FT_CACHE_SIZE=400000
#   CONFIG_MESSAGE_CACHE_IN_PSRAM=y
#   CONFIG_MESSAGE_CACHE_SIZE=96000


