#APP specific configuration.
config CUSTOM_MEM_MAP
    bool 
	select custom_mem_map
	default y if !SOC_SIMULATOR
    
config LV_BUILD_EXAMPLES
    bool 
    default y

# The app cache options (image cache / freetype cache ...) are shared by all
# examples now, see middleware/lvgl/Kconfig_mem.
# Enable the dedicated pools this project needs here, together with the size:
#
#   CONFIG_IMAGE_CACHE_IN_PSRAM_SIZE=1100000

