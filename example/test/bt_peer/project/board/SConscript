import os
import rtconfig
from building import *

cwd = GetCurrentDir()

# add general drivers
# board.c only: HAL_MspInit() comes from the SDK's weak default, and the board
# needs no peripheral MSP hook of its own.
src = Split('''
board.c
''')

path = [cwd]
path += [cwd + '/../linker_scripts']

group = DefineGroup('Drivers', src, depend = [''], CPPPATH = path)
Return('group')
