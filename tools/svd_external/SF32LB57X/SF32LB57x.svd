              </description>
              <bitOffset>2</bitOffset>
              <bitWidth>9</bitWidth>
            </field>
            <field>
              <name>CALC_CLR</name>
              <description>
              rot_max_col and rot_max_line calculation clear request. Write 1 to clear the result.
              </description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CALC_REQ</name>
