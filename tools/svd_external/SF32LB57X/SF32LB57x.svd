              <bitWidth>19</bitWidth>
            </field>
            <field>
              <name>RD_VALID_EN</name>
              <description>
              Enable the config value
              1: the valid data number start to read fifo equal to rd_valid[9:0]
              0: the valid data number start to read fifo equal to half of the fifo length
              </description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RSVD2</name>
              <description>
              </description>
              <bitOffset>10</bitOffset>
