            <field>
              <name>CAL_DONE</name>
              <description>
              Calibration done.
              After a new calibration started, results should be processed only when cal_done asserted.
              </description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CAL_EN</name>
