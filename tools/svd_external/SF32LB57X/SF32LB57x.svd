              <description>
              peripheral address increment
              PA will be increased by PINC each time dma transfer done in repetition mode
              </description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>MINC</name>
              <description>
              memory address increment
              MA will be increased by MINC each time dma transfer done in repetition mode
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>LCR1</name>
          <displayName>LCR1</displayName>
          <description></description>
          <addressOffset>0xe4</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ADDR</name>
              <description>
              linked-list address bit 31 to 2. 
              address bit 1 and bit 0 is fixed to 0 (word aligned).
              Write before linked-list start as list start address. 
              Read value indicate bit 31 to 2 of current list address if list has not been triggered, or next list address if current list has been triggered. After all lists finished, read value will be bit 31 to 2 of (last list address + 16)
              </description>
              <bitOffset>2</bitOffset>
              <bitWidth>30</bitWidth>
            </field>
            <field>
              <name>BUSY</name>
              <description>
              linked-list busy
              0: linked-list transfer idle
              1: linked-list transfer is busy
              </description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>START</name>
              <description>
              write 1 to start linked-list transfer. Will be cleared automatically
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
