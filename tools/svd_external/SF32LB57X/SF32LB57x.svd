          <name>FIFO6</name>
          <displayName>FIFO6</displayName>
          <description>FIFO6</description>
          <addressOffset>0x38</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
