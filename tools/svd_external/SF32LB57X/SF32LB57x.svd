        <register>
          <name>AHB_CTRL</name>
          <displayName>AHB_CTRL</displayName>
          <description></description>
          <addressOffset>0x15c</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
            </field>
            <field>
              <name>GREY_ORDER</name>
              <description>
              G4/G2 format bit order
              1'h0: byteG4 = {p1, p0}, byteG2 = {p3,p2,p1,p0}
              1'h1: byteG4 = {p0, p1}, byteG2 = {p0,p1,p2,p3}
              </description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>AHB_DIV_EN</name>
              <description>
              set 1 to divide AHB undefined length burst to fix length burst
              </description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>AHB_SEL</name>
              <description>
              select ahb write interface:
              1'b0: select AHB_A
              1'b1: select AHB_B
              </description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>O_FORMAT</name>
              <description>
              AHB output format:
              4'h0: RGB565
              4'h1: RGB888
              4'h2: ARGB8888
              4'h3: ARGB8565
              4'h4: A8
              4'h5: G8(8 bit for 1 pixel)
              4'h6: G4(4 bit for 1 pixel)
              4'h7: G2(2bit for 1 pixel)
              4'h8: F8(Flexible 8bit format)
              4'h9: F4(Flexible 4bit format)
              4'ha: F2(Flexible 2bit format)
              other: reserved
              </description>
              <bitOffset>1</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>DESTINATION</name>
              <description>
              The Data can be sent to two destinations:
              2'b0: AHB RAM
              2'b1: AHB LCD
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
