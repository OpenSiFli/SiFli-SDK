              0: interrupt disabled
              1: interrupt is generated whenever PE=1 in the ISR register
              </description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXEIE</name>
              <description>
