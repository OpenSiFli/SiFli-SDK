        <register>
          <name>SPI_CR</name>
          <displayName>SPI_CR</displayName>
          <description></description>
          <addressOffset>0x7c</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>PACKET_SIZE</name>
              <description>
              In SPI MTK mode, this is used to check whether the received packet size matches the value in this register, if they are not equal, a packet_size_err interrupt will be triggered.
              </description>
              <bitOffset>8</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>LINE_NUM_EN</name>
              <description>
              Used in SPI MTK mode                                                                                                      0:don't display the received line number in the line_num field of spi_sr   1:display the received line number in the line_num field of spi_sr
              </description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LOW_BYTE_FIRST</name>
              <description>
              when receiving line number and packet size                                                               0: Received byte first is msb in a word                                                                         1: Received byte first is lsb in a word
              </description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DATA_MSB_FIRST</name>
              <description>
              when reveive the data                                                                                                  0: the data received first is lsb                                                                                    1:the data received first is msb
              </description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>HEADER_MSB_FIRST</name>
              <description>
              when detecting the sync word                                                                                      0: the data received first is lsb                                                                                    1:the data received first is msb
              </description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DI_SWAP</name>
              <description>
              0x0:Not swap the spi data  at dcmi interface                                                          0x1:swap the data at the dcmi interface     
              </description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DI_SEL</name>
              <description>
              0x0: one-wire spi;                                                                                                         0x1: two-wire spi;                                                                                                               0x2: four-wire spi
              </description>
              <bitOffset>1</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>MTK_MODE</name>
              <description>
              0x0: Not mtk mode                                                                                                             0x1: mtk mode                                                                                                                                                                                                           
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>SPI_SYNC</name>
