              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>R0_PRIV_WR_ATTR</name>
              <description>
              region0 priviledge write attribute
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>APB_ACC_CFG</name>
          <displayName>APB_ACC_CFG</displayName>
          <description></description>
          <addressOffset>0x44</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>PRIV_ATTR</name>
              <description>
              write 1 to set priviledge access check
              </description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>SEC_ATTR</name>
              <description>
              write 1 to set secure access check
              bit0: GPIO2 reg
              bit2: RFC reg
              bit4: BT PHY reg
              bit5: CRC2 reg
              bit9: BT MAC reg
              other: reserved
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>AHB_ACC_CFG</name>
          <displayName>AHB_ACC_CFG</displayName>
          <description></description>
          <addressOffset>0x48</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>PRIV_ATTR</name>
              <description>
              write 1 to set priviledge access check
              </description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>SEC_ATTR</name>
              <description>
              write 1 to set secure access check
              bit0: RCC2 reg
              bit1: DMAC2 reg
              bit2: MAILBOX2 reg
              bit3: PINMUX2 reg
              bit4: PATCH reg
              bit5: USART4 reg
              bit6: USART5 reg
              bit7: SECU2 reg
              bit9: BTIM3 reg
              bit10: BTIM4 reg
              bit12: PTC2 reg
              bit15: SYSCFG2 reg
              other: reserved
