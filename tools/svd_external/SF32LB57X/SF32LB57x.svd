          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DMA_ADDR</name>
              <description>
              The DMA memory address.
              Note that the initial memory address written to this register must have a value such
              that it’s modulo 4 value is equal to 0. That is, DMA_ADDR[1:0] must be equal to
              2’b00. The lower two bits of this register are read only and cannot be set by
              software.
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
