              <name>INTRRXE_EP1_RX</name>
              <description>
              Rx Endpoint 1 interrupt enable.
              </description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RSVD</name>
              <description>
              Unused, always return 0
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>FRAME_INDEX_TESTMODE</name>
          <displayName>FRAME_INDEX_TESTMODE</displayName>
          <description>FRAME_INDEX_TESTMODE</description>
          <addressOffset>0x0c</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>TESTMODE_FORCE_HOST</name>
              <description>
              The CPU sets this bit to instruct the core to enter Host mode when the Session bit is set, regardless
              of whether it is connected to any peripheral. The state of the CID input, HostDisconnect and
              LineState signals are ignored. The core will then remain in Host mode until the Session bit is cleared,
              even if a device is disconnected, and if the Force_Host bit remains set, will re-enter Host mode the
              next time the Session bit is set.
              While in this mode, the status of the HOSTDISCON signal from the PHY may be read from bit 7 of
              the DevCtl register.
              The operating speed is determined from the Force_HS and Force_FS bits as follows:
              Force_HS Force_FS Operating Speed
              0 0 Low Speed
              0 1 Full Speed
              1 0 High Speed
              1 1 Undefined
              </description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TESTMODE_FIFO_ACCESS</name>
              <description>
              The CPU sets this bit to transfer the packet in the Endpoint 0 Tx FIFO to the Endpoint 0 Rx FIFO.
              It is cleared automatically.
              </description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TESTMODE_FORCE_FS</name>
              <description>
              The CPU sets this bit either in conjunction with bit 7 above or to force the MUSBHDRC into Fullspeed
              mode when it receives a USB reset.
              </description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TESTMODE_FORCE_HS</name>
              <description>
              The CPU sets this bit either in conjunction with bit 7 above or to force the MUSBHDRC into Highspeed
              mode when it receives a USB reset.
              </description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TESTMODE_TEST_PACKET</name>
              <description>
              (High-speed mode) The CPU sets this bit to enter the Test_Packet test mode. In this mode, the
              MUSBHDRC repetitively transmits on the bus a 53-byte test packet, the form of which is defined
              in the Universal Serial Bus Specification Revision 2.0, Section 7.1.20 (and in the MUSBHDRC
              Programmer's Guide). Note: The test packet has a fixed format and must be loaded into the
              Endpoint 0 FIFO before the test mode is entered.
              </description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TESTMODE_TEST_K</name>
              <description>
              (High-speed mode) The CPU sets this bit to enter the Test_K test mode. In this mode, the MUSBHDRC
              transmits a continuous K on the bus.
              </description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TESTMODE_TEST_J</name>
              <description>
              (High-speed mode) The CPU sets this bit to enter the Test_J test mode. In this mode, the MUSBHDRC
              transmits a continuous J on the bus.
              </description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TESTMODE_TEST_SE0_NAK</name>
              <description>
              (High-speed mode) The CPU sets this bit to enter the Test_SE0_NAK test mode. In this mode, the
              MUSBHDRC remains in High-speed mode but responds to any valid IN token with a NAK.
              </description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>20</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>INDEX_INDEX</name>
              <description>
              Selected Endpoint
              </description>
              <bitOffset>16</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>RSVD2</name>
              <description>
              </description>
              <bitOffset>11</bitOffset>
              <bitWidth>5</bitWidth>
            </field>
            <field>
              <name>FRAME_NUMBER</name>
              <description>
              Frame is a 16-bit read-only register that holds the last received frame number.
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>11</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>TXMAXP_TXCSR</name>
          <displayName>TXMAXP_TXCSR</displayName>
          <description>TXMAXP_TXCSR</description>
          <addressOffset>0x10</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>TXCSR_AUTOSET</name>
              <description>
              If the CPU sets this bit, TxPktRdy will be automatically set when data of the maximum packet size
              (value in TxMaxP) is loaded into the Tx FIFO. If a packet of less than the maximum packet size is
              loaded, then TxPktRdy will have to be set manually. Note: Should not be set for either high-bandwidth
              Isochronous endpoints or high-bandwidth Interrupt endpoints.
              </description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXCSR_ISO</name>
              <description>
              The CPU sets this bit to enable the Tx endpoint for Isochronous transfers, and clears it to enable
              the Tx endpoint for Bulk or Interrupt transfers. Note: This bit only has any effect in Peripheral mode. In
              Host mode, it always returns zero.
              </description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXCSR_MODE</name>
              <description>
              The CPU sets this bit to enable the endpoint direction as Tx, and clears it to enable the endpoint
              direction as Rx. Note: This bit only has any effect where the same endpoint FIFO is used for both Tx and Rx transactions.
              </description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXCSR_DMAREQENAB</name>
              <description>
              The CPU sets this bit to enable the DMA request for the Tx endpoint.
              </description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXCSR_FRCDATATOG</name>
              <description>
              The CPU sets this bit to force the endpoint data toggle to switch and the data packet to be cleared
              from the FIFO, regardless of whether an ACK was received. This can be used by Interrupt Tx
              endpoints that are used to communicate rate feedback for Isochronous endpoints.
              </description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXCSR_DMAREQMODE</name>
              <description>
              The CPU sets this bit to select DMA Mode 1 and clears this bit to select DMA Mode 0.
              Note: This bit must not be cleared either before or in the same cycle as the above DMAReqEnab bit is cleared.
              </description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>24</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>TXCSR_INCOMPTX</name>
              <description>
              When the endpoint is being used for high-bandwidth Isochronous/Interrupt transfers, this bit is set to indicate where a large packet has been split into 2 or 3 packets for transmission but insufficient IN tokens have been received to send all the parts. Note: In anything other than a high bandwidth transfer, this bit will always return 0.
              </description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXCSR_CLRDATATOG</name>
              <description>
              The CPU writes a 1 to this bit to reset the endpoint data toggle to 0.
              </description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXCSR_SENTSTALL</name>
              <description>
              This bit is set when a STALL handshake is transmitted. The FIFO is flushed and the TxPktRdy bit
              is cleared (see below). The CPU should clear this bit.
              </description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXCSR_SENDSTALL</name>
              <description>
              The CPU writes a 1 to this bit to issue a STALL handshake to an IN token. The CPU clears this
              bit to terminate the stall condition. Note::(i) The FIFO should be flushed before SendStall is set. (ii) This bit has no effect where the endpoint is being used for Isochronous transfers.
              </description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXCSR_FLUSHFIFO</name>
              <description>
              The CPU writes a 1 to this bit to flush the latest packet from the endpoint Tx FIFO. The FIFO pointer is reset, the TxPktRdy bit (below) is cleared and an interrupt is generated. May be set simultaneously with TxPktRdy to abort the packet that is currently being loaded into the FIFO. Note: FlushFIFO should only be used when TxPktRdy is set. At other times, it may cause data to be corrupted. Also note that, if the FIFO is double-buffered, FlushFIFO may need to be set twice to completely clear the FIFO.
              </description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXCSR_UNDERRUN</name>
              <description>
              The USB sets this bit if an IN token is received when the TxPktRdy bit not set. The CPU should
              clear this bit.
              </description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXCSR_FIFONOTEMPTY</name>
              <description>
              Control Status register for peripheral Tx endpoint. (Index register set to select
              Endpoints 1 – 15)
              Control Status register for Endpoint 0.(Index register set to select Endpoint 0)
              </description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXCSR_TXPKTRDY</name>
              <description>
              Control Status register for peripheral Tx endpoint. (Index register set to select
              Endpoints 1 – 15)
              Control Status register for Endpoint 0.(Index register set to select Endpoint 0)
              </description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXMAXP_TXMAXP</name>
              <description>
              Maximum packet size for peripheral Tx endpoint. (Index register set to select Endpoints
              1 – 15 only)
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RXMAXP_RXCSR</name>
          <displayName>RXMAXP_RXCSR</displayName>
          <description>RXMAXP_RXCSR</description>
          <addressOffset>0x14</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RXCSR_AUTOSET</name>
              <description>
              If the CPU sets this bit then the RxPktRdy bit will be automatically cleared when a packet of
              RxMaxP bytes has been unloaded from the Rx FIFO. When packets of less than the maximum
              packet size are unloaded, RxPktRdy will have to be cleared manually. Note: Should not be set for high bandwidth Isochronous endpoints.
              </description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXCSR_ISO</name>
              <description>
              The CPU sets this bit to enable the Rx endpoint for Isochronous transfers, and clears it to enable
              the Rx endpoint for Bulk or Interrupt transfers. Note: This bit only has any effect in Peripheral mode. In
              Host mode, it always returns zero.
              </description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXCSR_DMAREQENAB</name>
              <description>
              The CPU sets this bit to enable the DMA request for the Rx endpoint.
              </description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXCSR_DISNYET_PIDERR</name>
              <description>
              Bulk/Interrupt Transactions: The CPU sets this bit to disable the sending of NYET handshakes.
              When set, all successfully received Rx packets are ACK'd including at the point at which the FIFO
              becomes full. Note: This bit only has any effect in High-speed mode, in which mode it should be set for all Interrupt endpoints.
              ISO Transactions: The core sets this bit to indicate a PID error in the received packet.
              </description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXCSR_DMAREQMODE</name>
              <description>
              The CPU sets this bit to select DMA Mode 1 and clears this bit to select DMA Mode 0.
              Note: This bit should not be cleared in the same cycle as RxPktRdy is cleared.
              endpoints that are used to communicate rate feedback for Isochronous endpoints.
              </description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>25</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>RXCSR_INCOMPRX</name>
              <description>
              This bit is set in a high-bandwidth Isochronous/Interrupt transfer if the packet in the Rx FIFO is
              incomplete because parts of the data were not received. It is cleared when RxPktRdy is cleared. Note:
              In anything other than a high-bandwidth transfer, this bit will always return 0.
              </description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXCSR_CLRDATATOG</name>
              <description>
              The CPU writes a 1 to this bit to reset the endpoint data toggle to 0.
              </description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXCSR_SENTSTALL</name>
              <description>
              This bit is set when a STALL handshake is transmitted. The FIFO is flushed and the TxPktRdy bit
              is cleared (see below). The CPU should clear this bit.
              </description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXCSR_SENDSTALL</name>
              <description>
              The CPU writes a 1 to this bit to issue a STALL handshake to an IN token. The CPU clears this
              bit to terminate the stall condition. Note::(i) The FIFO should be flushed before SendStall is set. (ii) This bit has no effect where the endpoint is being used for Isochronous transfers.
              </description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXCSR_FLUSHFIFO</name>
              <description>
              The CPU writes a 1 to this bit to flush the next packet to be read from the endpoint Rx FIFO.
              The FIFO pointer is reset and the RxPktRdy bit (below) is cleared. Note: FlushFIFO should only be
              used when RxPktRdy is set. At other times, it may cause data to be corrupted. Also note that, if the
              FIFO is double-buffered, FlushFIFO may need to be set twice to completely clear the FIFO..
              </description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXCSR_DATAERROR</name>
              <description>
              This bit is set when RxPktRdy is set if the data packet has a CRC or bit-stuff error. It is cleared when RxPktRdy is cleared. Note: This bit is only valid when the endpoint is operating in ISO mode. In Bulk mode, it always returns zero.
              </description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXCSR_OVERRUN</name>
              <description>
              This bit is set if an OUT packet cannot be loaded into the Rx FIFO. The CPU should clear this bit.
              Note: This bit is only valid when the endpoint is operating in ISO mode. In Bulk mode, it always returns zero.
              </description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXCSR_FIFOFULL</name>
              <description>
              This bit is set when no more packets can be loaded into the Rx FIFO.
              </description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXCSR_RXPKTRDY</name>
              <description>
              CThis bit is set when a data packet has been received. The CPU should clear this bit when the packet
              has been unloaded from the Rx FIFO. An interrupt is generated when the bit is set.
              </description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXMAXP_RXMAXP</name>
              <description>
              Maximum packet size for peripheral Rx endpoint. (Index register set to select Endpoints
              1 – 15 only)
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>COUNT</name>
          <displayName>COUNT</displayName>
          <description>COUNT</description>
          <addressOffset>0x18</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>COUNT0_RXCOUNT</name>
              <description>
              Number of bytes in peripheral Rx endpoint FIFO. (Index register set to select
              Endpoints 1 – 15)
              Number of received bytes in Endpoint 0 FIFO. (Index register set to select Endpoint 0)
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>FIFOSIZE_CFG</name>
          <displayName>FIFOSIZE_CFG</displayName>
          <description>FIFOSIZE_CFG</description>
          <addressOffset>0x1c</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>FIFOSIZE_CFG</name>
              <description>
              Returns the configured size of the selected Rx FIFO and Tx FIFOs (Endpoints 1 – 15 only).
              Returns details of core configuration. (Index register set to select Endpoint 0.)
              </description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>24</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>FIFO0</name>
          <displayName>FIFO0</displayName>
          <description>FIFO0</description>
          <addressOffset>0x20</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>FIFO</name>
              <description>
              This address range provides 16 addresses for CPU access to the FIFOs for each endpoint. Writing to these addresses loads data into the TxFIFO for the corresponding endpoint. Reading from these addresses unloads data from the RxFIFO for the corresponding endpoint.Transfers to and from FIFOs may be 8-bit, 16-bit or 32-bit as required, and any combination of access is allowed
              provided the data accessed is contiguous.
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>FIFO1</name>
          <displayName>FIFO1</displayName>
          <description>FIFO1</description>
          <addressOffset>0x24</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>FIFO</name>
              <description>
              This address range provides 16 addresses for CPU access to the FIFOs for each endpoint. Writing to these addresses loads data into the TxFIFO for the corresponding endpoint. Reading from these addresses unloads data from the RxFIFO for the corresponding endpoint.Transfers to and from FIFOs may be 8-bit, 16-bit or 32-bit as required, and any combination of access is allowed
              provided the data accessed is contiguous.
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>FIFO2</name>
          <displayName>FIFO2</displayName>
          <description>FIFO2</description>
          <addressOffset>0x28</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>FIFO</name>
              <description>
              This address range provides 16 addresses for CPU access to the FIFOs for each endpoint. Writing to these addresses loads data into the TxFIFO for the corresponding endpoint. Reading from these addresses unloads data from the RxFIFO for the corresponding endpoint.Transfers to and from FIFOs may be 8-bit, 16-bit or 32-bit as required, and any combination of access is allowed
              provided the data accessed is contiguous.
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>FIFO3</name>
          <displayName>FIFO3</displayName>
          <description>FIFO3</description>
          <addressOffset>0x2c</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>FIFO</name>
              <description>
              This address range provides 16 addresses for CPU access to the FIFOs for each endpoint. Writing to these addresses loads data into the TxFIFO for the corresponding endpoint. Reading from these addresses unloads data from the RxFIFO for the corresponding endpoint.Transfers to and from FIFOs may be 8-bit, 16-bit or 32-bit as required, and any combination of access is allowed
              provided the data accessed is contiguous.
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>FIFO4</name>
          <displayName>FIFO4</displayName>
          <description>FIFO4</description>
          <addressOffset>0x30</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>FIFO</name>
              <description>
              This address range provides 16 addresses for CPU access to the FIFOs for each endpoint. Writing to these addresses loads data into the TxFIFO for the corresponding endpoint. Reading from these addresses unloads data from the RxFIFO for the corresponding endpoint.Transfers to and from FIFOs may be 8-bit, 16-bit or 32-bit as required, and any combination of access is allowed
              provided the data accessed is contiguous.
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
