            </field>
            <field>
              <name>INTRUSB_RESET_BABBLE_EN</name>
              <description>
              Enable Reset_Babble
              </description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INTRUSB_RESUME_EN</name>
              <description>
              Enable Resume
              </description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INTRUSB_SUSPEND_EN</name>
              <description>
              Enable Suspend
              </description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INTRUSB_VBUS_ERROR</name>
              <description>
              Set when VBus drops below the VBus Valid threshold during a session. Only valid when
              MUSBHDRC is 'A' device.
              </description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INTRUSB_SESS_REQ</name>
              <description>
              Set when Session Request signaling has been detected. Only valid when MUSBHDRC is 'A' device.
              </description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INTRUSB_DISCON</name>
              <description>
              Set in Host mode when a device disconnect is detected. Set in Peripheral mode when a session
              ends. Valid at all transaction speeds.
              </description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INTRUSB_CONN</name>
              <description>
              Set when a device connection is detected. Only valid in Host mode. Valid at all transaction speeds.
              </description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INTRUSB_SOF</name>
              <description>
              Set when a new frame starts.
              </description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INTRUSB_RESET_BABBLE</name>
              <description>
              Set in Peripheral mode when Reset signaling is detected on the bus.
              Set in Host mode when babble is detected. Note: Only active after first SOF has been sent.
              </description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INTRUSB_RESUME</name>
              <description>
              Set when Resume signaling is detected on the bus while the MUSBHDRC is in Suspend mode.
              </description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INTRUSB_SUSPEND</name>
              <description>
              Set when Suspend signaling is detected on the bus. Only valid in Peripheral mode.
              </description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
