              <description>
              </description>
              <bitOffset>10</bitOffset>
              <bitWidth>22</bitWidth>
            </field>
            <field>
              <name>CNT</name>
              <description>
              repeat counter
              0,1: no repetition
              others: repetition mode. Dma transfer will repeat for CNT times in direct mode. PA and MA may increase after each repetition.
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>10</bitWidth>
            </field>
          </fields>
