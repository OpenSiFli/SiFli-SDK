              01 = Burst Mode 1 : INCR4 or unspecified length
              10 = Burst Mode 2 : INCR8, INCR4 or unspecified length
              11 = Burst Mode 3 : INCR16, INCR8, INCR4 or unspecified length
              </description>
              <bitOffset>9</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>DMA_ERR</name>
              <description>
              Bus Error Bit. Indicates that a bus error has been observed on the input
              AHB_HRESPM[1:0]. This bit is cleared by software.
              </description>
