              1: address skip every two line
              </description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>WIDTH</name>
              <description>
              source image width(including padding), unit is bytes
              </description>
              <bitOffset>13</bitOffset>
              <bitWidth>15</bitWidth>
            </field>
