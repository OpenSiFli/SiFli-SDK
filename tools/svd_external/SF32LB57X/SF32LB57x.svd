    <peripheral>
      <name>DCMI</name>
      <description></description>
      <groupName>DCMI</groupName>
      <baseAddress>0x50040000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CR</name>
          <displayName>CR</displayName>
          <description></description>
          <addressOffset>0x00</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>26</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
            <field>
              <name>IPI_EN</name>
              <description>
              not used
              </description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IF_SEL</name>
              <description>
              0x0:parallel interface ; 0x1: spi_interface
              </description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RSTB_S</name>
              <description>
              </description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RSTB</name>
              <description>
              </description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FCLKEN</name>
              <description>
              </description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FCLKDIV</name>
              <description>
              </description>
              <bitOffset>16</bitOffset>
              <bitWidth>5</bitWidth>
            </field>
            <field>
              <name>ESS_SWAP</name>
              <description>
              </description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ENABLE</name>
              <description>
              DCMI enable                                                                                                                   0: DCMI disable                                                                                                              1: DCMI enable                                                                                                                Note: The DCMI configuration registers should be programmed correctly before enabling this Bit        
              </description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RSVD2</name>
              <description>
              </description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EDM</name>
              <description>
              Extended data mode                                                                                                   000: Interface captures 8-bit data on every pixel clock                                          001: Interface captures 10-bit data on every pixel clock                                        010: Interface captures 12-bit data on every pixel clock                                         011: Interface captures 14-bit data on every pixel clock                                       100: Interface captures 16-bit data on every pixel clock                                 Other value not support                                                                                            Note:  Only used in DVP mode
              </description>
              <bitOffset>10</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>HALF_WORD_SWAP</name>
              <description>
              half-word swap                                                                                                              0:  Not swap the two half-words within a word stored in RAM                            1: Swap the two half-words within a word stored in RAM
              </description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BIT_SWAP</name>
              <description>
              data bit swap                                                                                                                 0: Sort the data according to the default most-significant-bit-first (MSB-first) order                                                                                                                                1:  Sort the data in order from least significant (LSB) to most significant bit (MSB).
              </description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>VSPOL</name>
              <description>
              Vertical synchrozation polarity                                                                              This bit indicates the level on the DCMI_VSYNC pin when the data are not valid on the parallel interface                                                                            0:DCMI_VSYNC active low                                                                                      1:DCMI_VSYNC active  high                                                                                       Note: Only used in DVP mode                                                                      
              </description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>HSPOL</name>
              <description>
              Horizontal synchrozation polarity                                                                              This bit indicates the level on the DCMI_HSYNC pin when the data are not valid on the parallel interface                                                                            0:DCMI_HSYNC active low                                                                                      1:DCMI_HSYNC active  high                                                                                        Note: Only used in DVP mode                                                                     
              </description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PCKPOL</name>
              <description>
              pixel clock polarity                                                                                                   This bit configures the capture edge of the pixel clock                                         0: Rising edge active                                                                                                    1: Falling edge active
              </description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ESS</name>
              <description>
              Embedded synchronization select  0:Hardware synchronization data capture(frame/line start/stop) is synchronized with the DCMI_HSYNC/DCMI_VSYNC signals.   1: Embedded synchronization data capture is synchronized with syncchronization codes embedded in the data flow Note: Valid only for 8-bit parallel data. HSPOL/VSPOL are ignored when the ESS bit is set. This bit is disable in JPED mode
              </description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>JPEG</name>
              <description>
              JPEG format                                                                                                                            0: Uncompressed video format                                                                                        1: This bit is used for JPEG data transfers The DCMI_HSYNC signal is used as data enable. The crop and embedded synchronization features (Ess bit) cannot be used in this mode
              </description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CROP</name>
              <description>
              crop feature :                                                                                                            0:The full image is captured.                                                                               1:Only the data inside the window specified by the crop register will be captured. 
              </description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CM</name>
              <description>
              capture mode                                                                                                                  0 : Continuous grab mode -The received data are transferred into the destination memory through the DMA.                                                                     1: Snapshot mode(single frame) -Once actived, the interface waits for the start of frame and then transfers a single through the DMA.
              </description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CAPTURE</name>
              <description>
              Capture enable                                                                                                              0: Capture disabled.                                                                                                      1: Capture enabled.                                                                                                    Note: when capture mode equal 1, then it is necessary to manually configure the capture register to 0 and then to 1 to trigger the second capture
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>SR</name>
          <displayName>SR</displayName>
          <description></description>
          <addressOffset>0x4</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>3</bitOffset>
              <bitWidth>29</bitWidth>
            </field>
            <field>
              <name>FNE</name>
              <description>
              FIFO not empty , This bit gived the status of the FIFO                                                 1: FIFO contains valid data                                                                                             0:FIFO empty
              </description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>VSYNC</name>
              <description>
              </description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>HSYNC</name>
              <description>
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RIS</name>
          <displayName>RIS</displayName>
          <description></description>
          <addressOffset>0x8</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>6</bitOffset>
              <bitWidth>26</bitWidth>
            </field>
            <field>
              <name>PACK_SIZE_ERR_RIS</name>
              <description>
              This bit is set when in spi mode, one line data size configured in DCMI_SPI_CR is different from captured data in data flow. It is cleared by writing a '1' to the PACK_SIZE_ISC bit in DCMI_ICR. 
              </description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LINE_RIS</name>
              <description>
              This bit is set when the hsync changes from the inactive state to the active state. It is cleared by writing a '1' to the LINE_ISC bit in DCMI_ICR
              </description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>VSYNC_RIS</name>
              <description>
              This bit is set when the vsync changes from the inactive state to the active state. It is cleared by writing a '1' to the VSYNC_ISC bit in DCMI_ICR
              </description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FSM_ERR_RIS</name>
              <description>
              Synchronization error raw interrupt status                                                                    0: No synchronization error detected                                                                              1: Embedded synchronization characters are not received in the correct order  It is cleared by writing a '1' to the ERR_ICS bit in DCMI_ICR    
              </description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>OVR_RIS</name>
              <description>
              Overrun raw interrupt status                                                                                       0: No data buffer overrun occurred                                                                                 1: A data buffer overrun occurred and the data FIFO is corrupted.                         This bit is clear by writing a '1' to the OVR_ISC bit in DCMI_ICR
              </description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FRAME_RIS</name>
              <description>
              Capture complete raw interrupt status                                                                      0 : No new capture                                                                                                         1: A  frame has been catured.                                                                                      This bit is cleared by writing a '1' to the FRAME_ISC bit in DCMI_ICR
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>IE</name>
          <displayName>IE</displayName>
          <description></description>
          <addressOffset>0xc</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>6</bitOffset>
              <bitWidth>26</bitWidth>
            </field>
            <field>
              <name>PACK_SIZE_ERR_IE</name>
              <description>
              packet size error interrupt error enable
              </description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LINE_IE</name>
              <description>
              line interrupt enable
              </description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>VSYNC_IE</name>
              <description>
              vsync interrupt enable 
              </description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FSM_ERR_IE</name>
              <description>
              Synchronization error raw interrupt  enable
              </description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>OVR_IE</name>
              <description>
              Overrun raw interrupt enable
              </description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FRAME_IE</name>
              <description>
              Capture complete raw interrupt enable                                                                     
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>MIS</name>
          <displayName>MIS</displayName>
          <description></description>
          <addressOffset>0x10</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>6</bitOffset>
              <bitWidth>26</bitWidth>
            </field>
            <field>
              <name>PACK_SIZE_ERR_MIS</name>
              <description>
              packet size error masked interrupt status
              </description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LINE_MIS</name>
              <description>
              line masked interrupt status
              </description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>VSYNC_MIS</name>
              <description>
              vsync masked interrupt status
              </description>
