              0: none
              1: red
              2: green
              3: blue
              </description>
              <bitOffset>10</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>W_R</name>
              <description>
              red dither width
              </description>
              <bitOffset>7</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>W_G</name>
              <description>
              green dither width
              </description>
              <bitOffset>4</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>W_B</name>
              <description>
              blue dither width
              </description>
              <bitOffset>1</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>EN</name>
              <description>
              dither enable
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DITHER_LFSR</name>
          <displayName>DITHER_LFSR</displayName>
