          <description></description>
          <addressOffset>0x84</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>LINE_END</name>
              <description>
              In SPI zhanxun mode is line start delimiter code.                                                     In SPI MTK mode is data packet demiliter code
              </description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>LINE_START</name>
              <description>
              line start delimiter code 
              </description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>FRAME_END</name>
              <description>
              frame end delimiter code
              </description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>FRAME_START</name>
              <description>
              Frame start delimiter code                                                                                          
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>BP</name>
          <displayName>BP</displayName>
          <description></description>
          <addressOffset>0x88</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
            </field>
            <field>
              <name>BYTE3_PO</name>
              <description>
              Used to indicate the position within a word where the received fourth byte of data is placed                                                                                                                         0x0: first byte                                                                                                                 0x1:second byte                                                                                                                                    0x2: third byte                                                                                                                     0x3: fourth byte
              </description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>BYTE2_PO</name>
              <description>
              Used to indicate the position within a word where the received third byte of data is placed                                                                                                                         0x0: first byte                                                                                                                 0x1:second byte                                                                                                                                    0x2: third byte                                                                                                                     0x3: fourth byte
              </description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>BYTE1_PO</name>
              <description>
              Used to indicate the position within a word where the received second byte of data is placed                                                                                                                         0x0: first byte                                                                                                                 0x1:second byte                                                                                                                                    0x2: third byte                                                                                                                     0x3: fourth byte
              </description>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>BYTE0_PO</name>
              <description>
              Used to indicate the position within a word where the received first byte of data is placed                                                                                                                         0x0: first byte                                                                                                                 0x1:second byte                                                                                                                                    0x2: third byte                                                                                                                     0x3: fourth byte
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>SPI_SR</name>
          <displayName>SPI_SR</displayName>
          <description></description>
          <addressOffset>0x8c</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>PACKET_SIZE</name>
              <description>
              Used to indicate received packet size
