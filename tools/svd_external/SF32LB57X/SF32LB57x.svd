          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>END_ADDR</name>
              <description>
              </description>
              <bitOffset>2</bitOffset>
              <bitWidth>30</bitWidth>
            </field>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RAM1_RW_CFG</name>
          <displayName>RAM1_RW_CFG</displayName>
          <description></description>
          <addressOffset>0x40</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
            </field>
            <field>
              <name>R1_SEC_RD_ATTR</name>
              <description>
              region1 secure read attribute
              </description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>R1_SEC_WR_ATTR</name>
              <description>
              region1 secure write attribute
              </description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>R1_PRIV_RD_ATTR</name>
              <description>
              region1 priviledge read attribute
              </description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>R1_PRIV_WR_ATTR</name>
              <description>
              region1 priviledge write attribute
              </description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>R0_SEC_RD_ATTR</name>
              <description>
              region0 secure read attribute
              </description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>R0_SEC_WR_ATTR</name>
              <description>
              region0 secure write attribute
              </description>
