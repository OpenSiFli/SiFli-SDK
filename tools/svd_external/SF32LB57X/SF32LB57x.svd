        <register>
          <name>DEVCTL_TXFIFOSZ_RXFIFOSZ</name>
          <displayName>DEVCTL_TXFIFOSZ_RXFIFOSZ</displayName>
          <description>DEVCTL_TXFIFOSZ_RXFIFOSZ</description>
          <addressOffset>0x60</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>29</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>DPB_RX</name>
              <description>
              Defines whether double-packet buffering supported. When '1', double-packet buffering is
              supported. When '0', only single-packet buffering is supported.
              </description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXFIFOSZ</name>
              <description>
              Rx Endpoint FIFO size,The option of setting FIFO sizes dynamically only applies to Endpoints 1…15.
              9.2.2 and 12)
              SZ[3:0] Packet Size (Bytes)
              0 0 0 0 8
              0 0 0 1 16
              0 0 1 0 32
              0 0 1 1 64
              0 1 0 0 128
              0 1 0 1 256
              0 1 1 0 512
              0 1 1 1 1024
              1 0 0 0 2048
              1 0 0 1 4096
              D3 – D0 SZ[3:0]
              If DPB = 0, the FIFO will also be this size; if DPB = 1, the FIFO will be twice this size.
              </description>
              <bitOffset>24</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>RSVD2</name>
              <description>
              </description>
              <bitOffset>21</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>DPB_TX</name>
              <description>
              Defines whether double-packet buffering supported. When '1', double-packet buffering is
              supported. When '0', only single-packet buffering is supported.
              </description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXFIFOSZ</name>
              <description>
              Tx Endpoint FIFO size,The option of setting FIFO sizes dynamically only applies to Endpoints 1…15.
              9.2.2 and 12)
              SZ[3:0] Packet Size (Bytes)
              0 0 0 0 8
              0 0 0 1 16
              0 0 1 0 32
              0 0 1 1 64
              0 1 0 0 128
              0 1 0 1 256
              0 1 1 0 512
              0 1 1 1 1024
              1 0 0 0 2048
              1 0 0 1 4096
              D3 – D0 SZ[3:0]
              If DPB = 0, the FIFO will also be this size; if DPB = 1, the FIFO will be twice this size.
              </description>
              <bitOffset>16</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>RSVD3</name>
              <description>
              </description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>DEVCTL_BDEVICE</name>
              <description>
              This Read-only bit indicates whether the MUSBHDRC is operating as the 'A' device or the 'B'
              device. 0 ⇒ 'A' device; 1 ⇒ 'B' device. Only valid while a session is in progress.
              Note: If the core is in Force_Host mode (i.e. a session has been started with Testmode.D7 = 1), this
              bit will indicate the state of the HOSTDISCON input signal from the PHY.
              </description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DEVCTL_FSDEV</name>
              <description>
              This Read-only bit is set when a full-speed or high-speed device has been detected being connected
              to the port. (High-speed devices are distinguished from full-speed by checking for high-speed
              chirps when the device is reset.) Only valid in Host mode.
              </description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DEVCTL_LSDEV</name>
              <description>
              This Read-only bit is set when a low-speed device has been detected being connected to the port.
              Only valid in Host mode.
              </description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DEVCTL_VBUS</name>
              <description>
              These Read-only bits encode the current VBus level as follows:
              D4 D3 Meaning
              0 0 Below SessionEnd
              0 1 Above SessionEnd, below AValid
              1 0 Above AValid, below VBusValid
              1 1 Above VBusValid
              </description>
              <bitOffset>3</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>DEVCTL_HOST_MODE</name>
              <description>
              This Read-only bit is set when the MUSBHDRC is acting as a Host.
              </description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DEVCTL_HOST_REQ</name>
              <description>
              When set, the MUSBHDRC will initiate the Host Negotiation when Suspend mode is entered. It is
              cleared when Host Negotiation is completed. See Section 15. ('B' device only)
              </description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DEVCTL_SESSION</name>
              <description>
              When operating as an 'A' device, this bit is set or cleared by the CPU to start or end a session.
              When operating as a 'B' device, this bit is set/cleared by the MUSBHDRC when a session starts/ends.
              It is also set by the CPU to initiate the Session Request Protocol, or cleared by the CPU when in
              Suspend mode to perform a software disconnect. Note: Clearing this bit when the core is not
              suspended will result in undefined behavior.
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>FIFO_ADDR</name>
          <displayName>FIFO_ADDR</displayName>
          <description>FIFO_ADDR</description>
          <addressOffset>0x64</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>29</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>RX_FIFO_AD</name>
              <description>
              Start address of the endpoint FIFO in units of 8 bytes as follows:
              AD[12:0] Start Address
              0 0 0 0 0000
              0 0 0 1 0008
              0 0 0 2 0010
              … …
              1 F F F FFF8
              </description>
              <bitOffset>16</bitOffset>
              <bitWidth>13</bitWidth>
            </field>
            <field>
              <name>RSVD2</name>
              <description>
              </description>
              <bitOffset>13</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>TX_FIFO_AD</name>
              <description>
              Start address of the endpoint FIFO in units of 8 bytes as follows:
              AD[12:0] Start Address
              0 0 0 0 0000
              0 0 0 1 0008
              0 0 0 2 0010
              … …
              1 F F F FFF8
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>13</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RSVD15</name>
          <displayName>RSVD15</displayName>
          <description></description>
          <addressOffset>0x68</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
          </fields>
        </register>
        <register>
          <name>HWVERS</name>
          <displayName>HWVERS</displayName>
          <description>HWVERS</description>
          <addressOffset>0x6c</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>RC</name>
              <description>
              Set to '1' if RTL used from a Release Candidate rather than from a full release of the core.
              </description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>XX</name>
              <description>
              Major Version Number (Range 0 – 31).
              </description>
              <bitOffset>10</bitOffset>
              <bitWidth>5</bitWidth>
            </field>
            <field>
              <name>YYY</name>
              <description>
              Minor Version Number (Range 0 – 999).
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>10</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RSVD14</name>
          <displayName>RSVD14</displayName>
          <description></description>
          <addressOffset>0x70</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
          </fields>
        </register>
        <register>
          <name>EPINFO_RAMINFO_LINKINFO_VPLEN</name>
          <displayName>EPINFO_RAMINFO_LINKINFO_VPLEN</displayName>
          <description>EPINFO_RAMINFO_LINKINFO_VPLEN</description>
          <addressOffset>0x78</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x3C5C0000</resetValue>
          <fields>
            <field>
              <name>VPLEN</name>
              <description>
              Sets the duration of the VBus pulsing charge in units of 546.1 μs. (The default setting corresponds
              to 32.77ms.)
              </description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>LINKINFO_WTCON</name>
              <description>
              Sets the wait to be applied to allow for the user's connect/disconnect filter in units of 533.3ns.
              (The default setting corresponds to 2.667μs.)
              </description>
              <bitOffset>20</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>LINKINFO_WTID</name>
              <description>
              Sets the delay to be applied from IDPULLUP being asserted to IDDIG being considered valid
              in units of 4.369ms. (The default setting corresponds to 52.43ms.)
              </description>
              <bitOffset>16</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>RAMINFO_DMACHANS</name>
              <description>
              The number of DMA channels implemented in the design.
              </description>
              <bitOffset>12</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>RAMINFO_RAMBITS</name>
              <description>
              The width of the RAM address bus – 1.
              </description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>EPINFO_RXENDPOINTS</name>
              <description>
              The number of Rx endpoints implemented in the design.
              </description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>EPINFO_TXENDPOINTS</name>
              <description>
              The number of Tx endpoints implemented in the design.
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>EOF1</name>
          <displayName>EOF1</displayName>
          <description>EOF1</description>
          <addressOffset>0x7c</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00727780</resetValue>
          <fields>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>LS_EOF1</name>
              <description>
              Sets for Low-speed transactions the time before EOF to stop beginning new transactions, in units
              of 1.067μs. (The default setting corresponds to 121.6μs.)
              </description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>FS_EOF1</name>
              <description>
              Sets for Full-speed transactions the time before EOF to stop beginning new transactions, in units
              of 533.3ns. (The default setting corresponds to 63.46μs.)
              </description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>HS_EOF1</name>
              <description>
              Sets for High-speed transactions the time before EOF to stop beginning new transactions, in units
              of 133.3ns. (The default setting corresponds to 17.07μs.)
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RSVD13</name>
          <displayName>RSVD13</displayName>
          <description></description>
          <addressOffset>0x80</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
          </fields>
        </register>
        <register>
          <name>TXMAXP_CSR0</name>
          <displayName>TXMAXP_CSR0</displayName>
          <description>TXMAXP_CSR0</description>
          <addressOffset>0x100</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>25</bitOffset>
              <bitWidth>7</bitWidth>
            </field>
            <field>
              <name>CSR0_FLUSHFIFO</name>
              <description>
              The CPU writes a 1 to this bit to flush the next packet to be transmitted/read from the
              Endpoint 0 FIFO. The FIFO pointer is reset and the TxPktRdy/RxPktRdy bit (below) is
              cleared. Note: FlushFIFO should only be used when TxPktRdy/RxPktRdy is set. At other
              times, it may cause data to be corrupted.
              </description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CSR0_SERVICEDSETUPEND</name>
              <description>
              The CPU writes a 1 to this bit to clear the SetupEnd bit. It is cleared automatically.
              </description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CSR0_SERVICEDRXPKTRDY</name>
              <description>
              The CPU writes a 1 to this bit to clear the RxPktRdy bit. It is cleared automatically.
              </description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CSR0_SENDSTALL</name>
              <description>
              The CPU writes a 1 to this bit to terminate the current transaction. The STALL handshake
              will be transmitted and then this bit will be cleared automatically. Note: The FIFO should be
              flushed before SendStall is set.
              </description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CSR0_SETUPEND</name>
              <description>
              This bit will be set when a control transaction ends before the DataEnd bit has been set.
              An interrupt will be generated and the FIFO flushed at this time. The bit is cleared by
              the CPU writing a 1 to the ServicedSetupEnd bit.
              </description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CSR0_DATAEND</name>
              <description>
              The CPU sets this bit:
              1. When setting TxPktRdy for the last data packet.
              2. When clearing RxPktRdy after unloading the last data packet.
              3. When setting TxPktRdy for a zero length data packet.
              It is cleared automatically.
              </description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CSR0_SENTSTALL</name>
              <description>
              The USB sets this bit if an IN token is received when the TxPktRdy bit not set. The CPU should
              clear this bit.
              </description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CSR0_TXPKTRDY</name>
              <description>
              The CPU sets this bit after loading a data packet into the FIFO. It is cleared automatically when the data packet has been transmitted. An interrupt is generated (if enabled) when the bit is cleared.
              </description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CSR0_RXPKTRDY</name>
              <description>
              This bit is set when a data packet has been received. An interrupt is generated when this bit
              is set. The CPU clears this bit by setting the ServicedRxPktRdy bit.
              </description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXMAXP_TXMAXP</name>
              <description>
              Maximum packet size for peripheral Tx endpoint. (Index register set to select Endpoints
              1 – 15 only)
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RXMAXP_RXCSR2</name>
          <displayName>RXMAXP_RXCSR2</displayName>
          <description>RXMAXP_RXCSR</description>
          <addressOffset>0x104</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RXCSR_AUTOSET</name>
              <description>
              If the CPU sets this bit then the RxPktRdy bit will be automatically cleared when a packet of
              RxMaxP bytes has been unloaded from the Rx FIFO. When packets of less than the maximum
              packet size are unloaded, RxPktRdy will have to be cleared manually. Note: Should not be set for high bandwidth Isochronous endpoints.
              </description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXCSR_ISO</name>
              <description>
              The CPU sets this bit to enable the Rx endpoint for Isochronous transfers, and clears it to enable
              the Rx endpoint for Bulk or Interrupt transfers. Note: This bit only has any effect in Peripheral mode. In
              Host mode, it always returns zero.
              </description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXCSR_DMAREQENAB</name>
              <description>
              The CPU sets this bit to enable the DMA request for the Rx endpoint.
              </description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXCSR_DISNYET_PIDERR</name>
              <description>
              Bulk/Interrupt Transactions: The CPU sets this bit to disable the sending of NYET handshakes.
              When set, all successfully received Rx packets are ACK'd including at the point at which the FIFO
              becomes full. Note: This bit only has any effect in High-speed mode, in which mode it should be set for all Interrupt endpoints.
              ISO Transactions: The core sets this bit to indicate a PID error in the received packet.
              </description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXCSR_DMAREQMODE</name>
              <description>
              The CPU sets this bit to select DMA Mode 1 and clears this bit to select DMA Mode 0.
              Note: This bit should not be cleared in the same cycle as RxPktRdy is cleared.
              endpoints that are used to communicate rate feedback for Isochronous endpoints.
              </description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>25</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>RXCSR_INCOMPRX</name>
              <description>
              This bit is set in a high-bandwidth Isochronous/Interrupt transfer if the packet in the Rx FIFO is
              incomplete because parts of the data were not received. It is cleared when RxPktRdy is cleared. Note:
              In anything other than a high-bandwidth transfer, this bit will always return 0.
              </description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXCSR_CLRDATATOG</name>
              <description>
              The CPU writes a 1 to this bit to reset the endpoint data toggle to 0.
              </description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXCSR_SENTSTALL</name>
              <description>
              This bit is set when a STALL handshake is transmitted. The FIFO is flushed and the TxPktRdy bit
              is cleared (see below). The CPU should clear this bit.
              </description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXCSR_SENDSTALL</name>
              <description>
              The CPU writes a 1 to this bit to issue a STALL handshake to an IN token. The CPU clears this
              bit to terminate the stall condition. Note::(i) The FIFO should be flushed before SendStall is set. (ii) This bit has no effect where the endpoint is being used for Isochronous transfers.
              </description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXCSR_FLUSHFIFO</name>
              <description>
              The CPU writes a 1 to this bit to flush the next packet to be read from the endpoint Rx FIFO.
              The FIFO pointer is reset and the RxPktRdy bit (below) is cleared. Note: FlushFIFO should only be
              used when RxPktRdy is set. At other times, it may cause data to be corrupted. Also note that, if the
              FIFO is double-buffered, FlushFIFO may need to be set twice to completely clear the FIFO..
              </description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXCSR_DATAERROR</name>
              <description>
              This bit is set when RxPktRdy is set if the data packet has a CRC or bit-stuff error. It is cleared when RxPktRdy is cleared. Note: This bit is only valid when the endpoint is operating in ISO mode. In Bulk mode, it always returns zero.
              </description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXCSR_OVERRUN</name>
              <description>
              This bit is set if an OUT packet cannot be loaded into the Rx FIFO. The CPU should clear this bit.
              Note: This bit is only valid when the endpoint is operating in ISO mode. In Bulk mode, it always returns zero.
              </description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXCSR_FIFOFULL</name>
              <description>
              This bit is set when no more packets can be loaded into the Rx FIFO.
              </description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXCSR_RXPKTRDY</name>
              <description>
              CThis bit is set when a data packet has been received. The CPU should clear this bit when the packet
              has been unloaded from the Rx FIFO. An interrupt is generated when the bit is set.
              </description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXMAXP_RXMAXP</name>
              <description>
              Maximum packet size for peripheral Rx endpoint. (Index register set to select Endpoints
              1 – 15 only)
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>COUNT0</name>
          <displayName>COUNT0</displayName>
          <description>COUNT</description>
          <addressOffset>0x108</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>7</bitOffset>
              <bitWidth>25</bitWidth>
            </field>
            <field>
              <name>COUNT0</name>
              <description>
              Number of received bytes in Endpoint 0 FIFO. (Index register set to select Endpoint 0)
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CONFIGDATA</name>
          <displayName>CONFIGDATA</displayName>
          <description>FIFOSIZE_CFG</description>
          <addressOffset>0x10c</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>MPRXE</name>
              <description>
              When set to '1', automatic amalgamation of bulk packets is selected (see Section 9)
              </description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MPTXE</name>
              <description>
              When set to '1', automatic splitting of bulk packets is selected (see Section 9)
              </description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BIGENDIAN</name>
              <description>
              When set to '1' indicates Big Endian ordering is selected.
              </description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>HBRXE</name>
              <description>
              When set to '1' indicates High-bandwidth Rx ISO Endpoint Support selected.
              </description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>HBTXE</name>
              <description>
              When set to '1' indicates High-bandwidth Tx ISO Endpoint Support selected.
              </description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DYNFIFO_SZ</name>
              <description>
              When set to '1' indicates Dynamic FIFO Sizing option selected.
              </description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SOFTCONE</name>
              <description>
              When set to '1' indicates Soft Connect/Disconnect option selected.
              </description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>UTMI_DATAWIDTH</name>
              <description>
              Indicates selected UTMI+ data width. 0 ⇒ 8 bits; 1 ⇒ 16 bits.
              </description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>24</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>TXMAXP_TXCSR_1</name>
          <displayName>TXMAXP_TXCSR_1</displayName>
          <description>TXMAXP_CSR1</description>
          <addressOffset>0x110</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>TXCSR_AUTOSET</name>
              <description>
              If the CPU sets this bit, TxPktRdy will be automatically set when data of the maximum packet size 
              (value in TxMaxP) is loaded into the Tx FIFO. If a packet of less than the maximum packet size is 
              loaded, then TxPktRdy will have to be set manually. Note: Should not be set for either high-bandwidth 
              Isochronous endpoints or high-bandwidth Interrupt endpoints.
              </description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXCSR_ISO</name>
              <description>
              The CPU sets this bit to enable the Tx endpoint for Isochronous transfers, and clears it to enable 
              the Tx endpoint for Bulk or Interrupt transfers. Note: This bit only has any effect in Peripheral mode. In 
              Host mode, it always returns zero.
              </description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXCSR_MODE</name>
              <description>
              The CPU sets this bit to enable the endpoint direction as Tx, and clears it to enable the endpoint 
              direction as Rx. Note: This bit only has any effect where the same endpoint FIFO is used for both Tx and Rx transactions.
              </description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXCSR_DMAREQENAB</name>
              <description>
               The CPU sets this bit to enable the DMA request for the Tx endpoint.
              </description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXCSR_FRCDATATOG</name>
              <description>
              The CPU sets this bit to force the endpoint data toggle to switch and the data packet to be cleared 
              from the FIFO, regardless of whether an ACK was received. This can be used by Interrupt Tx 
              endpoints that are used to communicate rate feedback for Isochronous endpoints.
              </description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXCSR_DMAREQMODE</name>
              <description>
              The CPU sets this bit to select DMA Mode 1 and clears this bit to select DMA Mode 0. 
              Note: This bit must not be cleared either before or in the same cycle as the above DMAReqEnab bit is cleared
              </description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>24</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>TXCSR_INCOMPTX</name>
              <description>
              When the endpoint is being used for high-bandwidth Isochronous/Interrupt transfers, this bit is 
              set to indicate where a large packet has been split into 2 or 3 packets for transmission but 
              insufficient IN tokens have been received to send all the parts. Note: In anything other than a high bandwidth transfer, this bit will always return 0.
              </description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXCSR_CLEARDATATOG</name>
              <description>
              The CPU writes a 1 to this bit to reset the endpoint data toggle to 0.
              </description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXCSR_SENTSTALL</name>
              <description>
              This bit is set when a STALL handshake is transmitted. The FIFO is flushed and the TxPktRdy bit 
              is cleared (see below). The CPU should clear this bit.
              </description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXCSR_SENDSTALL</name>
              <description>
              The CPU writes a 1 to this bit to issue a STALL handshake to an IN token. The CPU clears this 
              bit to terminate the stall condition. Note::(i) The FIFO should be flushed before SendStall is set. (ii) This bit has no effect where the endpoint is being used for Isochronous transfers.
              An interrupt will be generated and the FIFO flushed at this time. The bit is cleared by
              the CPU writing a 1 to the ServicedSetupEnd bit.
              </description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXCSR_FLUSHFIFO</name>
              <description>
              The CPU writes a 1 to this bit to flush the latest packet from the endpoint Tx FIFO. The FIFO pointer 
              is reset, the TxPktRdy bit (below) is cleared and an interrupt is generated. May be set simultaneously 
              with TxPktRdy to abort the packet that is currently being loaded into the FIFO. Note: FlushFIFO 
              should only be used when TxPktRdy is set. At other times, it may cause data to be corrupted. Also note 
              that, if the FIFO is double-buffered, FlushFIFO may need to be set twice to completely clear the FIFO.
              </description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXCSR_UNDERRUN</name>
              <description>
              The USB sets this bit if an IN token is received when the TxPktRdy bit not set. The CPU should 
              clear this bit.
              </description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXCSR_FIFO_NOT_EMPTY</name>
              <description>
              The USB sets this bit when there is at least 1 packet in the Tx FIFO.
              </description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXCSR_TXPKTRDY</name>
              <description>
              The CPU sets this bit after loading a data packet into the FIFO. It is cleared automatically when a data 
              packet has been transmitted. An interrupt is also generated at this point (if enabled). TxPktRdy is also 
              automatically cleared prior to loading a second packet into a double-buffered FIFO.
              is set. The CPU clears this bit by setting the ServicedRxPktRdy bit.
              </description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXMAXP_TXMAXP</name>
              <description>
              Maximum packet size for peripheral Tx endpoint. (Index register set to select Endpoints
              1 – 15 only)
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RXMAXP_RXCSR_1</name>
          <displayName>RXMAXP_RXCSR_1</displayName>
          <description>RXMAXP_RXCSR</description>
          <addressOffset>0x114</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RXCSR_AUTOCLEAR</name>
