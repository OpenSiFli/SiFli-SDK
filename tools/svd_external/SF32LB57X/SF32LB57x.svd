          <addressOffset>0x94</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>28</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>CNT_DUMMY</name>
              <description>
              dummy TE triggers after CNT_EN is set.  Skip the first CNT_DUMMY TE triggers, then start TE  counter.
              </description>
              <bitOffset>24</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>CNT_EN</name>
              <description>
              enable TE counter for window mode
              </description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CNT_CLR</name>
              <description>
              clear TE counter for window mode
              </description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FMARK_SOURCE</name>
              <description>
              TE signal source
              1: use TE signal from DSI
              0: use TE signal from external pin
              </description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FMARK_MODE</name>
              <description>
              TE signal trigger mode
              1: edge trigger
              0: pulse trigger
              </description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>VSYNC_DET_CNT</name>
              <description>
              vsync signal detect counter, used for mode 1 to detect vsync signal
              </description>
              <bitOffset>4</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>MODE</name>
              <description>
              0: vsync only TE mode 
              1: vsync+hsync TE mode
              2: window TE mode
              </description>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>FMARK_POL</name>
              <description>
              TE signal polarity
              </description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ENABLE</name>
              <description>
              TE enable
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
