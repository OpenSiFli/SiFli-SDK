          <access>read-write</access>
          <resetValue>0x00000010</resetValue>
          <fields>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>14</bitOffset>
              <bitWidth>18</bitWidth>
            </field>
            <field>
              <name>BURST_LEN</name>
              <description>
              Config the burst length, default value is 16
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>14</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>FDLR</name>
          <displayName>FDLR</displayName>
          <description>data length start to read fifo register</description>
          <addressOffset>0x50</addressOffset>
