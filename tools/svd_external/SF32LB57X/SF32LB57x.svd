              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>VHP_ISO</name>
              <description>
              Set 1 to force off all HPSYS related analog modules, including USB/DSI/DLL etc
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
