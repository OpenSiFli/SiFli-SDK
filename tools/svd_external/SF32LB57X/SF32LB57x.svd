              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>PIXEL_ORDER</name>
              <description>
              A4, A2, L4 color format pixel order
              0: ByteA4 = {P1, P0}, ByteA2 = (P3, P2, P1, P0), ByteL4 = {P1, P0}
              1: ByteA4 = {P0, P1}, ByteA2 = (P0, P1, P2, P3), ByteL4 = {P0, P1}
              </description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FIX_COLOR</name>
              <description>
              set this bit to 1, this layer output will be fixed to Alpha, BG_R, BG_G and BG_B
              </description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RSVD2</name>
              <description>
              </description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ENDIAN</name>
              <description>
              input 565 data format endian
              0: {R[4:0], G[5:3], G[2:0], B[4:0]}
              1: {G[2:0], B[4:0], R[4:0], G[5:3]}
              </description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BG_MODE</name>
              <description>
              Not used.
              </description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
