          <fields>
            <field>
              <name>INTRUSB_VBUS_ERROR_EN</name>
              <description>
              Enable Vbus_Error
              </description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INTRUSB_SESS_REQ_EN</name>
              <description>
              Enable Sess_Req
              </description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INTRUSB_DISCON_EN</name>
              <description>
              Enable Discon
              </description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INTRUSB_CONN_EN</name>
              <description>
