              <bitWidth>20</bitWidth>
            </field>
            <field>
              <name>CS2E</name>
              <description>
              Force CS2 enable
              </description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CS1SIZE</name>
              <description>
              0 - unlimited, 1 - 4Mb, 2 - 8Mb, 3 - 16Mb, 4 - 32Mb, 5 - 64Mb, 6 - 128Mb, 7 - 256Mb
              </description>
              <bitOffset>8</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>LOOP</name>
              <description>
              Loop CMD1/CMD2
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DCR2</name>
          <displayName>DCR2</displayName>
          <description>Device Control Register 2</description>
          <addressOffset>0x98</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>10</bitOffset>
              <bitWidth>22</bitWidth>
            </field>
            <field>
              <name>CFMT</name>
              <description>
              Commond format for UpSRAM only. Keep at 0, reserved for future use
              </description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BTYPE</name>
              <description>
              Burst type, set to 0 for 32Mb HyperRAM only
              </description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TCPHW</name>
              <description>
              For AMP32 only
              </description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>TCPHR</name>
              <description>
              For APM32 only
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTRSAR2</name>
          <displayName>CTRSAR2</displayName>
          <description>CTR Starting Address Register 2</description>
          <addressOffset>0x9c</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>SA</name>
              <description>
              </description>
