          <fields>
            <field>
              <name>INIT_VAL</name>
              <description>
              lfsr init load value
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CONV_CFG</name>
          <displayName>CONV_CFG</displayName>
          <description></description>
          <addressOffset>0x60</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>3</bitOffset>
              <bitWidth>29</bitWidth>
            </field>
            <field>
              <name>FORMAT</name>
              <description>
              CANVAS conversion format:
              0: ARGB
              1: G8
              2: G4
              3: G2
              4: F8
              5: F4
              6: F2
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>GREY_CONV</name>
          <displayName>GREY_CONV</displayName>
          <description></description>
          <addressOffset>0x64</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ORDER</name>
              <description>
              G4 format bit order
              1'h0: byteG4 = {p1, p0}, byteG2 = {p3,p2,p1,p0}
              1'h1: byteG4 = {p0, p1}, byteG2 = {p0,p1,p2,p3}
              </description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>COEF2</name>
              <description>
              </description>
              <bitOffset>20</bitOffset>
              <bitWidth>10</bitWidth>
            </field>
            <field>
              <name>COEF1</name>
              <description>
              </description>
              <bitOffset>10</bitOffset>
              <bitWidth>10</bitWidth>
            </field>
            <field>
              <name>COEF0</name>
              <description>
              grey = (coef0 * r + coef1 * g + coef2 * b) >> 10
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>10</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>FLEX_SEL_L</name>
          <displayName>FLEX_SEL_L</displayName>
