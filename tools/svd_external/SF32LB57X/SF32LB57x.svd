              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PCE</name>
              <description>
              Parity check enable. If enabled, parity bit is inserted at the MSB position 
              0: parity check disabled
              1: parity check enabled
              </description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PS</name>
              <description>
              Parity select
              0: even parity
              1: odd parity
              </description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PEIE</name>
              <description>
