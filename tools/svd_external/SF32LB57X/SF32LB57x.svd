        <register>
          <name>CLKCR</name>
          <displayName>CLKCR</displayName>
          <description>clock control register</description>
          <addressOffset>0x30</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00008001</resetValue>
          <fields>
            <field>
              <name>RSVD</name>
              <description>
              </description>
              <bitOffset>21</bitOffset>
              <bitWidth>11</bitWidth>
            </field>
            <field>
              <name>DIV</name>
              <description>
              Divide card clock counter
              Fsd_clock = fsd_clock / (div + 1)
              Default:: when AHB clock is 50 MHZ, card clock is divided into about 200 KHZ.
              </description>
              <bitOffset>8</bitOffset>
              <bitWidth>13</bitWidth>
            </field>
            <field>
              <name>RSVD2</name>
              <description>
              </description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>CLK_TUNE_SEL</name>
              <description>
              select clock delay for rx sample 
              0: no delay
              1: delay level 1 (~1.5ns typical)
              2: delay level 2 (~3ns typical)
              3: delay level 3 (~5ns typical)
              </description>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>VOID_FIFO_ERROR</name>
              <description>
              Void FIFO error
              0: close the function
              1: open the function
              If open it, when FIFO will be overrun or underrun soon, the SD_CLK and the clock enable to whole card_control module will be closed, and wait to host come to read or write FIFO.
              Note: this function needs to be supported by card.
              </description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>STOP_CLK</name>
              <description>
              Disable SD card clock
              1: stop SD card clock
              0: let SD card clock work
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PCR</name>
