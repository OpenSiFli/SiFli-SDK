              1'b1: select layer alpha
              </description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FORMAT</name>
              <description>
              video layer input format
              4'h0: RGB565
              4'h1: RGB888
              4'h2: ARGB8888
              4'h3: ARGB8565
              4'h4: A8
              4'h5: A4
              4'h6: L8
              4'h7: A2
              4'h8: L4
              other: reserved
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
