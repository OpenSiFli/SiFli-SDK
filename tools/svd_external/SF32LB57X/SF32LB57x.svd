            </field>
            <field>
              <name>WDT_CNT</name>
              <description>
              </description>
              <bitOffset>3</bitOffset>
              <bitWidth>24</bitWidth>
            </field>
            <field>
              <name>WDT_ACTIVE</name>
              <description>
              Watchdog runs when 1, else 0
              </description>
              <bitOffset>2</bitOffset>
