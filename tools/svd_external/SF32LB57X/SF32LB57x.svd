              0: interrupt disabled
              1: interrupt is generated whenever TC=1 in the ISR register
              </description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXNEIE</name>
              <description>
