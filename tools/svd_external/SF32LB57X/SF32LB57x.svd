          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DLY_CNT1</name>
              <description>
              TE delay counter1, used for window mode
              TE window is active when (te_cnt  lte  cnt0 || te_cnt >= cnt1)  and  and  te_cnt >= cnt2
              </description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
