              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ALPHA_BLEND</name>
              <description>
              set 1 to enable alpha blending mode. Use layer alpha as blending factor for image with Alpha.
              Alpha_out = Layer_alpha * Image_alpha
              </description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ALPHA</name>
