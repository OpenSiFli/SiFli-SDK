        </register>
        <register>
          <name>PC1</name>
          <displayName>PC1</displayName>
          <description>PC register for core 1</description>
          <addressOffset>0x7c</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>VAL</name>
              <description>
              Instant value of PC(program counter).
              </description>
              <bitOffset>0</bitOffset>
