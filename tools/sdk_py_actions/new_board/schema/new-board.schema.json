{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensifli.com/schemas/new-board.schema.json",
  "title": "New Board Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chip_series",
    "chip_model",
    "app_storage",
    "board_name",
    "generate_base"
  ],
  "properties": {
    "chip_series": {
      "type": "string",
      "enum": ["52", "56", "57", "58"]
    },
    "chip_model": {
      "type": "string",
      "minLength": 1
    },
    "app_storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["nor", "nand", "sdmmc"]
        },
        "port": {
          "type": "string",
          "enum": ["mpi1", "mpi2", "mpi3", "mpi4", "mpi5", "sdmmc1", "sdmmc2"]
        },
        "size_mb": {
          "type": "integer",
          "minimum": 1
        },
        "pinmux_type": {
          "type": "string",
          "enum": ["type0", "type1"]
        },
        "block_size_kb": {
          "type": "integer",
          "enum": [128, 256]
        }
      }
    },
    "external_storage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "port", "size_mb"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["nor", "nand", "sdmmc"]
          },
          "port": {
            "type": "string",
            "enum": ["mpi1", "mpi2", "mpi3", "mpi4", "mpi5", "sdmmc1", "sdmmc2"]
          },
          "size_mb": {
            "type": "integer",
            "minimum": 1
          },
          "block_size_kb": {
            "type": "integer",
            "enum": [128, 256]
          },
          "pinmux_type": {
            "type": "string",
            "enum": ["type0", "type1"]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "not": {
                    "const": "nand"
                  }
                }
              },
              "required": ["type"]
            },
            "then": {
              "not": {
                "required": ["block_size_kb"]
              }
            }
          }
        ]
      }
    },
    "board_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "generate_base": {
      "type": "boolean"
    },
    "base_name": {
      "type": "string",
      "minLength": 1
    },
    "with_acpu": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "chip_series": {
            "const": "58"
          },
          "app_storage": {
            "properties": {
              "port": {
                "enum": ["mpi4", "sdmmc1"]
              }
            },
            "required": ["port"]
          }
        },
        "required": ["chip_series", "app_storage"]
      },
      "then": {
        "properties": {
          "app_storage": {
            "required": ["pinmux_type"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "app_storage": {
            "required": ["pinmux_type"]
          }
        },
        "required": ["app_storage"]
      },
      "then": {
        "properties": {
          "chip_series": {
            "const": "58"
          },
          "app_storage": {
            "properties": {
              "port": {
                "enum": ["mpi4", "sdmmc1"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "generate_base": {
            "const": false
          }
        },
        "required": ["generate_base"]
      },
      "then": {
        "required": ["base_name"]
      }
    },
    {
      "if": {
        "properties": {
          "app_storage": {
            "properties": {
              "type": {
                "not": {
                  "const": "nand"
                }
              }
            },
            "required": ["type"]
          }
        },
        "required": ["app_storage"]
      },
      "then": {
        "properties": {
          "app_storage": {
            "not": {
              "required": ["block_size_kb"]
            }
          }
        }
      }
    }
  ]
}
